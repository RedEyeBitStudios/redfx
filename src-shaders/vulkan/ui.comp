#version 460
layout (local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout (binding = 5, rgba8) uniform image2D color_buffer;

void main()
{
	const ivec2 pixel_coord = ivec2(gl_WorkGroupID.xy * gl_WorkGroupSize.xy + gl_LocalInvocationID.xy);
	imageStore(color_buffer, pixel_coord, vec4(1.0f));
}